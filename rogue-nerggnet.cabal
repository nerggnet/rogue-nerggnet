cabal-version:      3.0
name:               rogue-nerggnet
version:            1
synopsis:           A small Rogue-like game in a TUI, using Brick and Haskell
description:        A terminal Rogue-like dungeon crawler built with Brick and
                    Vty. Maps, monsters, items, NPCs, locked doors and scripted
                    triggers are all defined in a JSON world file, so dungeons
                    can be authored without changing any code.
license:            MIT
license-file:       LICENSE
author:             nerggnet
maintainer:         nerggnet
category:           Game
homepage:           https://github.com/nerggnet/rogue-nerggnet
build-type:         Simple
extra-doc-files:    README.md
                    CHANGELOG.md
tested-with:        GHC == 9.12.2 || == 9.14.1

source-repository head
    type:     git
    location: https://github.com/nerggnet/rogue-nerggnet.git

common warnings
    ghc-options: -Wall

-- All game code lives in the library so that both the executable and the
-- test-suite can import it.
library
    import:           warnings
    hs-source-dirs:   src
    exposed-modules:  Game.Types
                      Game.State
                      Game.Logic
                      Game.GridUtils
                      File.Types
                      File.MapIO
                      UI.Draw
                      UI.MainUI
    build-depends:    base               >= 4.21  && < 4.23
                    , aeson              >= 2.2   && < 2.4
                    , brick              >= 2.8   && < 3
                    , bytestring         >= 0.11  && < 0.13
                    , containers         >= 0.6   && < 0.9
                    , directory          >= 1.3   && < 1.4
                    , linear             >= 1.22  && < 1.24
                    , vty                >= 6.0   && < 7
                    , vty-crossplatform  >= 0.4   && < 0.6
    default-language: Haskell2010
    default-extensions: OverloadedRecordDot

executable rogue-nerggnet
    import:           warnings
    hs-source-dirs:   app
    main-is:          Main.hs
    build-depends:    base            >= 4.21 && < 4.23
                    , rogue-nerggnet
    default-language: Haskell2010
    ghc-options:      -threaded

test-suite spec
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    other-modules:    Fixtures
                      Game.GridUtilsSpec
                      Game.StateSpec
                      Game.LogicSpec
                      File.MapIOSpec
                      UI.DrawSpec
                      Render
                      UI.LayoutSpec
                      UI.ScreenSpec
    build-depends:    base            >= 4.21 && < 4.23
                    , rogue-nerggnet
                    , aeson           >= 2.2  && < 2.4
                    , containers      >= 0.6  && < 0.9
                    , directory       >= 1.3  && < 1.4
                    , filepath        >= 1.4  && < 1.6
                    , hspec           >= 2.10 && < 2.13
                    , linear          >= 1.22 && < 1.24
                    , QuickCheck      >= 2.14 && < 2.19
                    , brick           >= 2.8  && < 3
                    , text            >= 2.0  && < 2.2
                    , vector          >= 0.13 && < 0.14
                    , vty             >= 6.0  && < 7
    default-language: Haskell2010
    default-extensions: OverloadedRecordDot
    ghc-options:      -threaded
